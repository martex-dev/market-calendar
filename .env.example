# FRED API key — free, no card. https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# Turso / libSQL. Leave BOTH blank for local development: the app falls back
# to a local SQLite file (market-calendar.db) automatically.
# Required in production — Vercel's filesystem is ephemeral, so the file
# fallback cannot work there.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Any random string. Set this in Vercel and it will send it as a Bearer token
# on cron invocations, which is what protects /api/cron/refresh from being
# triggered by anyone who finds the URL.
CRON_SECRET=
